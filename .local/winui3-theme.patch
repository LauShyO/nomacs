+    padding: 18px 24px 10px 24px;
+}
+
+/* ---- settings page: group title above a rounded card
+        (the card is the group's content widget, see DkGroupContent) ---- */
+QLabel#subTitle {
+    font-size: 12pt;
+    font-weight: 600;
+    padding: 14px 2px 7px 2px;
+}
+
+QWidget#DkGroupContent {
+    background-color: #ffffff;
+    border: 1px solid #e7e7e7;
+    border-radius: 8px;
+}
+
+/* ---- controls (settings, batch page, dialogs) ---- */
+nmc--DkPreferenceWidget QPushButton,
+nmc--DkBatchWidget QPushButton,
+QDialog QPushButton {
+    background-color: #ffffff;
+    border: 1px solid #e0e0e0;
+    border-bottom: 1px solid #d0d0d0;
+    border-radius: 4px;
+    padding: 5px 14px;
+    min-height: 20px;
+}
+
+nmc--DkPreferenceWidget QPushButton:hover,
+nmc--DkBatchWidget QPushButton:hover,
+QDialog QPushButton:hover {
+    background-color: #f5f5f5;
+}
+
+nmc--DkPreferenceWidget QPushButton:pressed,
+nmc--DkBatchWidget QPushButton:pressed,
+QDialog QPushButton:pressed {
+    background-color: #f0f0f0;
+}
+
+nmc--DkPreferenceWidget QPushButton:disabled,
+nmc--DkBatchWidget QPushButton:disabled,
+QDialog QPushButton:disabled {
+    color: rgba(0, 0, 0, 90);
+    background-color: #f5f5f5;
+}
+
+nmc--DkPreferenceWidget QComboBox,
+nmc--DkBatchWidget QComboBox,
+QDialog QComboBox,
+nmc--DkPreferenceWidget QLineEdit,
+nmc--DkBatchWidget QLineEdit,
+QDialog QLineEdit,
+nmc--DkPreferenceWidget QSpinBox,
+nmc--DkBatchWidget QSpinBox,
+QDialog QSpinBox,
+nmc--DkPreferenceWidget QDoubleSpinBox,
+QDialog QDoubleSpinBox {
+    background-color: #ffffff;
+    border: 1px solid #e0e0e0;
+    border-bottom: 1px solid #c8c8c8;
+    border-radius: 4px;
+    padding: 5px 8px;
+    min-height: 20px;
+    selection-background-color: ACCENT_COLOR;
+}
+
+nmc--DkPreferenceWidget QComboBox:focus,
+nmc--DkBatchWidget QComboBox:focus,
+QDialog QComboBox:focus,
+nmc--DkPreferenceWidget QLineEdit:focus,
+nmc--DkBatchWidget QLineEdit:focus,
+QDialog QLineEdit:focus,
+nmc--DkPreferenceWidget QSpinBox:focus,
+nmc--DkBatchWidget QSpinBox:focus,
+QDialog QSpinBox:focus,
+nmc--DkPreferenceWidget QDoubleSpinBox:focus,
+QDialog QDoubleSpinBox:focus {
+    border-bottom: 2px solid ACCENT_COLOR;
+}
+
+QComboBox::drop-down {
+    border: none;
+    width: 26px;
+}
+
+QComboBox::down-arrow {
+    image: url(":/nomacs/img/down.svg");
+    width: 10px;
+    height: 10px;
+}
+
+QComboBox QAbstractItemView {
+    background-color: #f9f9f9;
+    border: 1px solid #e0e0e0;
+    border-radius: 8px;
+    padding: 4px;
+    outline: 0;
+    selection-background-color: rgba(0, 0, 0, 14);
+    selection-color: #1b1b1b;
+}
+
+QGroupBox {
+    border: 1px solid #e7e7e7;
+    border-radius: 8px;
+    margin-top: 14px;
+    padding-top: 16px;
+    font-weight: 600;
+}
+
+QGroupBox::title {
+    subcontrol-origin: margin;
+    subcontrol-position: top left;
+    left: 12px;
+    padding: 0 4px;
+}
+
+QSlider::groove:horizontal {
+    height: 4px;
+    border-radius: 2px;
+    background-color: rgba(0, 0, 0, 45);
+}
+
+QSlider::sub-page:horizontal {
+    border-radius: 2px;
+    background-color: ACCENT_COLOR;
+}
+
+QSlider::handle:horizontal {
+    width: 18px;
+    height: 18px;
+    border-radius: 9px;
+    margin: -7px 0;
+    background-color: ACCENT_COLOR;
+}
+
+QProgressBar {
+    border: 1px solid #e0e0e0;
+    border-radius: 4px;
+    background-color: rgba(0, 0, 0, 8);
+    text-align: center;
+}
+
+QProgressBar::chunk {
+    border-radius: 3px;
+    background-color: ACCENT_COLOR;
+}
+
+/* ---- toolbars, status bar, tabs, thin scrollbars ---- */
+QToolBar {
+    background-color: BACKGROUND_COLOR;
+    border: none;
+    border-bottom: 1px solid rgba(0, 0, 0, 20);
+    padding: 2px 4px;
+    spacing: 2px;
+}
+
+QToolButton {
+    border-radius: 4px;
+    padding: 4px;
+}
+
+QToolButton:hover {
+    background-color: rgba(0, 0, 0, 12);
+}
+
+QToolButton:checked {
+    background-color: rgba(0, 0, 0, 18);
+}
+
+QStatusBar {
+    background-color: BACKGROUND_COLOR;
+    border-top: 1px solid rgba(0, 0, 0, 20);
+}
+
+QTabBar::tab {
+    background-color: transparent;
+    border: none;
+    border-top-left-radius: 6px;
+    border-top-right-radius: 6px;
+    padding: 6px 14px;
+    margin-right: 2px;
+}
+
+QTabBar::tab:selected {
+    background-color: rgba(0, 0, 0, 16);
+}
+
+QTabBar::tab:hover {
+    background-color: rgba(0, 0, 0, 8);
+}
+
+QScrollBar:vertical {
+    background-color: transparent;
+    width: 10px;
+    margin: 0;
+}
+
+QScrollBar::handle:vertical {
+    background-color: rgba(0, 0, 0, 55);
+    border-radius: 5px;
+    min-height: 30px;
+}
+
+QScrollBar:horizontal {
+    background-color: transparent;
+    height: 10px;
+    margin: 0;
+}
+
+QScrollBar::handle:horizontal {
+    background-color: rgba(0, 0, 0, 55);
+    border-radius: 5px;
+    min-width: 30px;
+}
+
+QScrollBar::add-line,
+QScrollBar::sub-line {
+    height: 0;
+    width: 0;
+}
+
+QScrollBar::add-page,
+QScrollBar::sub-page {
+    background-color: transparent;
+}
+
+QListWidget,
+QTreeWidget,
+QTableWidget {
+    border: 1px solid #e7e7e7;
+    border-radius: 8px;
+    padding: 4px;
+    outline: 0;
+}
+
+QListWidget::item,
+QTreeWidget::item,
+QTableWidget::item {
+    padding: 4px 6px;
+    border-radius: 4px;
+}
+
+QListWidget::item:selected,
+QTreeWidget::item:selected,
+QTableWidget::item:selected {
+    background-color: rgba(0, 0, 0, 16);
+    color: #1b1b1b;
+}
