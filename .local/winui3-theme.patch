+/* ========================================================================
+   LOCAL PATCH - WinUI 3 style overrides (dark)
+   Appended after the Dark theme rules. Everything below only applies
+   while this theme is selected; the stock themes are untouched.
+   Accent spots use ACCENT_COLOR (Windows system accent, see
+   DkThemeManager) so the UI follows the OS accent like WinUI does.
+   ======================================================================== */
+
+* {
+    font-family: "Segoe UI Variable Text", "Segoe UI", "Microsoft YaHei UI", "Microsoft YaHei", sans-serif;
+}
+
+/* ---- menus: rounded, padded, subtle hover (true see-through corners
+        come from the WA_TranslucentBackground set in code) ---- */
+QMenu {
+    background-color: #2c2c2c;
+    border: 1px solid #454545;
+    border-radius: 8px;
+    padding: 4px;
+}
+
+QMenu::item {
+    background-color: transparent;
+    border-radius: 4px;
+    padding: 6px 36px 6px 28px;
+    margin: 1px 2px;
+}
+
+QMenu::item:selected {
+    background-color: rgba(255, 255, 255, 20);
+}
+
+QMenu::item:disabled {
+    color: rgba(255, 255, 255, 90);
+}
+
+QMenu::icon:checked {
+    background-color: ACCENT_COLOR;
+    border-radius: 4px;
+}
+
+QMenu::separator {
+    height: 1px;
+    background-color: rgba(255, 255, 255, 20);
+    border: none;
+    margin: 5px 14px;
+}
+
+QMenuBar {
+    background-color: BACKGROUND_COLOR;
+    border-bottom: 1px solid rgba(255, 255, 255, 18);
+    padding: 2px 4px;
+}
+
+QMenuBar::item {
+    background-color: transparent;
+    border-radius: 4px;
+    padding: 5px 10px;
+}
+
+QMenuBar::item:selected,
+QMenuBar::item:pressed {
+    background-color: rgba(255, 255, 255, 20);
+}
+
+QToolTip {
+    background-color: #2c2c2c;
+    border: 1px solid #454545;
+    border-radius: 4px;
+    padding: 4px 8px;
+}
+
