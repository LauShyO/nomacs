+    border: none;
+}
+
+QPushButton:default {
+    background-color: rgba(255,255,255,30);
+}
+
+QPushButton:disabled {
+    border: 1px solid rgba(255,255,255,100);
+}
+
+QPushButton:default:disabled {
+    color: rgba(255,255,255,75);
+}
+
+QPushButton:pressed {
+    background-color: rgba(255,255,255,80);
