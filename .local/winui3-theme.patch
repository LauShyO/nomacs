+    margin: 1px 2px;
+}
+
+QMenu::item:selected {
+    background-color: rgba(0, 0, 0, 14);
+}
+
+QMenu::item:disabled {
+    color: rgba(0, 0, 0, 90);
+}
+
+QMenu::icon:checked {
+    background-color: ACCENT_COLOR;
+    border-radius: 4px;
+}
+
+QMenu::separator {
+    height: 1px;
+    background-color: rgba(0, 0, 0, 20);
+    border: none;
+    margin: 5px 14px;
+}
+
+QMenuBar {
+    background-color: BACKGROUND_COLOR;
+    border-bottom: 1px solid rgba(0, 0, 0, 20);
+    padding: 2px 4px;
+}
+
+QMenuBar::item {
+    background-color: transparent;
+    border-radius: 4px;
+    padding: 5px 10px;
+}
+
+QMenuBar::item:selected,
+QMenuBar::item:pressed {
+    background-color: rgba(0, 0, 0, 14);
+}
+
+QToolTip {
+    background-color: #f9f9f9;
+    border: 1px solid #e0e0e0;
+    border-radius: 4px;
+    padding: 4px 8px;
+}
+
+/* ---- toggle switches instead of checkboxes ---- */
+QCheckBox {
+    spacing: 10px;
+}
+
+QCheckBox::indicator {
+    width: 40px;
+    height: 20px;
+    background-color: transparent;
+    border: none;
+    image: url(":/nomacs/img/switch-off.svg");
+}
+
+QCheckBox::indicator:checked {
+    image: url(":/nomacs/img/switch-on.svg");
+}
+
+QCheckBox::indicator:disabled {
+    image: url(":/nomacs/img/switch-off-disabled.svg");
+}
+
+QCheckBox::indicator:checked:disabled {
+    image: url(":/nomacs/img/switch-on-disabled.svg");
+}
+
+QRadioButton {
+    spacing: 8px;
